#!/usr/bin/env Rscript
# =====================================================================
# Script 6: Cox regression and survival analysis of the six-gene score
#   (a) univariable Cox screening of the 71 overlapping genes
#   (b) six-gene Cox score, C-index, time-dependent AUC and Kaplan-Meier
#       in TCGA-COAD, with adjustment for age and pathological stage
#   (c) per-gene overall survival by optimal expression cutoff
#   (d) application of the score in GSE72970 (groups, expression, KM, AUC)
# Source: cox_venn71.R, six-gene score analysis, optimal-cutoff KM,
#         GSE72970 risk groups and multivariable Cox model.
# Inputs: TCGA-COAD expression and survival tables, clinical table,
#         71-gene list, GSE72970 expression/clinical objects.
# =====================================================================
suppressPackageStartupMessages({
  library(data.table); library(survival); library(ggplot2); library(timeROC)
})

BASE      <- "/Users/zhangxiaocheng/Desktop/self"
EXPR_FILE <- file.path(BASE, "TCGA_COAD_expression.csv")
SURV_FILE <- file.path(BASE, "cox_analysis", "06_analysis_samples.csv")
CLIN_FILE <- file.path(BASE, "cox_analysis", "clinical_COAD_clinicalMatrix.tsv")

OUT        <- file.path(BASE, "six_gene_survival_analysis")
TAB        <- file.path(OUT, "tables")
FIG        <- file.path(OUT, "figures")
KM_DIR     <- file.path(OUT, "per_gene_cutoff")
KM_MEDIAN_DIR <- file.path(BASE, "six_gene_OS_20261119")
GSE_DIR    <- file.path(OUT, "GSE72970_validation")
GSE_DATA_DIR <- file.path(BASE, "CRC_OS_colon_20261116", "01_datasets", "GSE72970")

for (d in c(OUT, TAB, FIG)) dir.create(d, recursive = TRUE, showWarnings = FALSE)
for (d in c(KM_DIR, GSE_DIR)) {
  dir.create(file.path(d, "tables"),  recursive = TRUE, showWarnings = FALSE)
  dir.create(file.path(d, "figures"), recursive = TRUE, showWarnings = FALSE)
}


# =====================================================================
# Section 1. Univariable Cox screening of the 71 overlapping genes
# =====================================================================
suppressMessages({library(data.table); library(survival)})
setwd(BASE)  ## all relative inputs live under BASE
outdir <- file.path(TAB, "univariable_cox_71"); dir.create(outdir, showWarnings = FALSE, recursive = TRUE)

## ---- 1. gene list ----
g <- fread("venn_genes_71.csv", header = FALSE, col.names = "gene")
g[, gene := gsub("\"", "", gene)]
g <- g[toupper(gene) != "SYMBOL" & gene != ""]
g <- unique(g, by = "gene")
cat("genes in list:", nrow(g), "\n")

## ---- 2. data ----
grp  <- fread("TCGA_group_list.csv")
surv <- fread("TCGA-COAD.survival.tsv.gz")
expr <- fread("TCGA_COAD_expression.csv", header = TRUE)
setnames(expr, 1, "gene")
sv <- as.data.frame(surv); rownames(sv) <- sv$sample

## ---- 3. samples: tumour only, one primary tumour per patient ----
tum  <- grp[Group == "Tumor", sample]
cand <- intersect(tum, sv$sample)
d <- data.table(sample = cand)
d[, suffix  := sub("^TCGA-[^-]+-[^-]+-", "", sample)]
d[, patient := sub("-[^-]+$", "", sample)]
d <- d[suffix %in% c("01A", "01B", "01C")]
d[, prio := match(suffix, c("01A", "01B", "01C"))]
setorder(d, patient, prio, sample)
d <- d[, .SD[1], by = patient]
samples <- sort(d$sample)
time  <- sv[samples, "OS.time"]; event <- sv[samples, "OS"]
cat("samples:", length(samples), "events:", sum(event), "\n")

## ---- 4. match genes ----
gl <- unique(g$gene)
present <- gl[gl %in% expr$gene]
missing <- setdiff(gl, expr$gene)
cat("matched in matrix:", length(present), "| missing:", length(missing), paste(missing, collapse = ","), "\n")

sub <- expr[gene %in% present]
X <- as.matrix(sub[, ..samples]); rownames(X) <- sub$gene
storage.mode(X) <- "double"
X <- X[present, , drop = FALSE]
mean_expr <- rowMeans(X); sd_expr <- apply(X, 1, sd)

## ---- 5. univariate Cox ----
y <- Surv(time, event)
fit1 <- function(i) {
  v <- X[i, ]
  f <- tryCatch(coxph.fit(matrix(v, ncol = 1), y, strata = NULL, offset = NULL, init = NULL,
                          control = coxph.control(iter.max = 30), weights = NULL,
                          method = "efron", rownames = NULL), error = function(e) NULL)
  if (is.null(f) || !is.finite(f$var[1, 1]) || f$var[1, 1] <= 0) return(c(NA, NA))
  c(f$coefficients[1], sqrt(f$var[1, 1]))
}
ab <- t(vapply(seq_along(present), fit1, numeric(2)))

res <- data.table(gene = present, n = length(samples), n_event = sum(event),
                  beta = ab[, 1], se = ab[, 2])
res[, z := beta / se]
res[, p := 2 * pnorm(-abs(beta / se))]
res[, HR := exp(beta)]
res[, HR_lower := exp(beta - 1.959964 * se)]
res[, HR_upper := exp(beta + 1.959964 * se)]
res[, HR_per_SD := exp(beta * sd_expr[gene])]
res[, mean_expr := mean_expr[gene]]
res[, sd_expr := sd_expr[gene]]
res[, FDR := p.adjust(p, method = "BH")]
res[, direction := fifelse(HR > 1, "risk", "protective")]
setorder(res, p)

fwrite(res, file.path(outdir, "71_cox_results.csv"))
fwrite(res[p < 0.05], file.path(outdir, "71_significant_p005.csv"))

cat("\n===== results (sorted by p) =====\n")
print(res[, .(gene, HR = round(HR, 2), lower = round(HR_lower, 2), upper = round(HR_upper, 2),
              p = signif(p, 3), FDR = signif(FDR, 3), mean_expr = round(mean_expr, 2))], nrows = 100)

cat("\np<0.05:", nrow(res[p < 0.05]), "of", nrow(res),
    "| FDR<0.05:", nrow(res[FDR < 0.05]), "| p<0.01:", nrow(res[p < 0.01]), "\n")
lo <- res[mean_expr < 1]
cat("low-expression (mean<1):", nrow(lo), "genes\n")
if (nrow(lo) > 0) print(lo[, .(gene, mean_expr = round(mean_expr, 3), HR = round(HR, 2), p = signif(p, 3))])

## optional: compare with the full 12,642-gene screen if the table is available
full_file <- "cox_analysis/02_cox_all_genes.csv"
if (file.exists(full_file)) {
  full <- fread(full_file)
  ov <- merge(res[, .(gene, p_71 = p)], full[, .(gene, p_full = p)], by = "gene")
  cat("\ncorrelation of log p with full 12,642-gene screen:",
      round(cor(log10(ov$p_71), log10(ov$p_full), use = "complete.obs"), 3), "\n")
  cat("in 71 list already p<0.05 in full screen:", sum(ov$p_full < 0.05), "of", nrow(ov), "\n")
}

## ---- 6. optional overlap with an externally supplied gene list ----
sup_file <- "significant_genes_list(1).csv"
if (file.exists(sup_file)) {
  sup <- fread(sup_file, col.names = c("gene", "supplied_p"))
  cat("\noverlap with supplied 40-gene list:", sum(res$gene %in% sup$gene), "genes:",
      paste(intersect(res$gene, sup$gene), collapse = ","), "\n")
  cat("of the", nrow(sup), "supplied genes, significant here:", sum(sup$gene %in% res[p < 0.05]$gene), "\n")
}

## ---- 7. forest plot ----
suppressMessages({library(ggplot2)})
pl <- copy(res)
pl[, sig := fifelse(p < 0.05, fifelse(HR > 1, "risk (p<0.05)", "protective (p<0.05)"), "not significant")]
setorder(pl, HR)
pl[, gene := factor(gene, levels = gene)]
p1 <- ggplot(pl, aes(x = HR, y = gene, colour = sig)) +
  geom_vline(xintercept = 1, linetype = "dashed", colour = "grey50") +
  geom_errorbarh(aes(xmin = HR_lower, xmax = HR_upper), height = 0.35, linewidth = 0.45) +
  geom_point(size = 1.9) +
  scale_x_log10(breaks = c(0.5, 0.7, 1, 1.5, 2, 3)) +
  scale_colour_manual(values = c("risk (p<0.05)" = "#C0392B", "protective (p<0.05)" = "#2C7FB8",
                                 "not significant" = "grey55")) +
  labs(x = "Hazard ratio per unit expression (95% CI, log scale)", y = NULL, colour = NULL,
       title = "Univariate Cox, 71 VENN genes",
       subtitle = paste0("TCGA-COAD tumours, n = ", length(samples), ", events = ", sum(event))) +
  theme_bw(base_size = 9) +
  theme(panel.grid.minor = element_blank(), legend.position = "bottom",
        plot.title = element_text(face = "bold"))
ggsave(file.path(outdir, "fig71_forest.pdf"), p1, width = 6.2, height = 9.5)
ggsave(file.path(outdir, "fig71_forest.png"), p1, width = 6.2, height = 9.5, dpi = 300)
cat("figure written\n")




# =====================================================================
# Section 2. Six-gene Cox score in TCGA-COAD
#   coefficients -> linear predictor -> C-index, time-dependent AUC,
#   Kaplan-Meier by median split -> adjustment for age and stage
# =====================================================================
suppressPackageStartupMessages({library(data.table); library(survival); library(timeROC)})

expr <- as.data.frame(fread(EXPR_FILE, check.names = FALSE))
rownames(expr) <- expr[[1]]
expr <- as.matrix(expr[, -1, drop = FALSE])
s <- fread(SURV_FILE)
co <- intersect(s$sample, colnames(expr))

genes6 <- c("FJX1", "TIMP1", "SRMS", "ZBTB12", "KPNA2", "BGN")
X <- data.frame(t(expr[genes6, co, drop = FALSE]), check.names = FALSE)
X$OS_time <- s$OS_time[match(co, s$sample)]
X$OS <- s$OS[match(co, s$sample)]
X$sample <- co

fit6 <- coxph(Surv(OS_time, OS) ~ FJX1 + TIMP1 + SRMS + ZBTB12 + KPNA2 + BGN, data = X)
X$score <- as.numeric(predict(fit6, type = "lp"))
X$score_z <- as.numeric(scale(X$score))

## ---- coefficients, hazard ratios and apparent C-index ----
sum6 <- summary(fit6)
coef_tab <- data.table(
  gene = names(coef(fit6)),
  coef = as.numeric(coef(fit6)),
  HR = sum6$coefficients[, "exp(coef)"],
  lower = sum6$conf.int[, "lower .95"],
  upper = sum6$conf.int[, "upper .95"],
  p = sum6$coefficients[, "Pr(>|z|)"]
)
coef_tab[, C_index := sum6$concordance[1]]
fwrite(coef_tab, file.path(TAB, "03_TCGA_six_gene_Cox_coefficients.csv"))
print(coef_tab)

## ---- time-dependent AUC of the score ----
roc <- timeROC(T = X$OS_time / 365.25, delta = X$OS, marker = X$score,
               cause = 1, times = c(1, 3, 5), iid = FALSE)
cat("time-dependent AUC (1/3/5 years):", paste(round(roc$AUC, 3), collapse = " | "), "\n")

## ---- Kaplan-Meier by median score ----
X$risk <- factor(ifelse(X$score > median(X$score), "High", "Low"), levels = c("Low", "High"))
km <- survfit(Surv(OS_time, OS) ~ risk, data = X)
lr <- survdiff(Surv(OS_time, OS) ~ risk, data = X)
p_lr <- 1 - pchisq(lr$chisq, df = 1)
cx <- summary(coxph(Surv(OS_time, OS) ~ risk, data = X))

kdf <- data.table(time = km$time, surv = km$surv, nc = km$n.censor,
                  risk = rep(sub("^risk=", "", names(km$strata)), km$strata))
kdf <- rbind(data.table(time = 0, surv = 1, nc = 0, risk = c("Low", "High")), kdf)
kdf[, risk := factor(risk, levels = c("Low", "High"))]
kdf[, time_years := time / 365.25]

p_km <- ggplot(kdf, aes(time_years, surv, colour = risk)) +
  geom_step(linewidth = 0.72) +
  geom_point(data = kdf[nc > 0 & time > 0], shape = 3, size = 1.05, stroke = 0.4, show.legend = FALSE) +
  scale_colour_manual(values = c(Low = "#2E86AB", High = "#C0392B"), name = "Six-gene score") +
  coord_cartesian(xlim = c(0, 12.5), ylim = c(0, 1)) +
  scale_x_continuous(breaks = seq(0, 12, 3)) +
  scale_y_continuous(breaks = seq(0, 1, 0.25)) +
  labs(x = "Time (years)", y = "Overall survival",
       title = "TCGA-COAD: overall survival by six-gene score",
       subtitle = sprintf("Median split; n = %d, %d deaths; log-rank P = %.3g; HR = %.2f (%.2f-%.2f)",
                          nrow(X), sum(X$OS), p_lr, cx$conf.int[1], cx$conf.int[3], cx$conf.int[4])) +
  theme_bw(base_size = 10) +
  theme(panel.grid.minor = element_blank(),
        plot.title = element_text(face = "bold", size = 11),
        plot.subtitle = element_text(size = 8.2))
ggsave(file.path(FIG, "02_TCGA_six_gene_score_KM.pdf"), p_km, width = 6.2, height = 4.6)
ggsave(file.path(FIG, "02_TCGA_six_gene_score_KM.png"), p_km, width = 6.2, height = 4.6, dpi = 400)

## ---- adjustment for age and pathological stage ----
clin <- fread(CLIN_FILE)
clin[, pat12 := substr(sampleID, 1, 12)]
st <- clin$pathologic_stage
stage <- ifelse(grepl("IV", st), "IV",
         ifelse(grepl("III", st), "III",
         ifelse(grepl("II", st), "II",
         ifelse(grepl("I", st), "I", NA))))
cl <- data.table(pat12 = clin$pat12, stage = stage,
                 age = suppressWarnings(as.numeric(clin$age_at_initial_pathologic_diagnosis)))
cl <- cl[!is.na(pat12)][!duplicated(pat12)]

X <- as.data.table(X)
X[, pat12 := substr(sample, 1, 12)]
d <- merge(X, cl, by = "pat12", all.x = TRUE)
d[, stage := factor(stage, levels = c("I", "II", "III", "IV"))]
d[, age10 := age / 10]
dd <- d[!is.na(stage) & !is.na(age)]
cat("complete cases:", nrow(dd), "deaths:", sum(dd$OS), "\n")

m_uni  <- coxph(Surv(OS_time, OS) ~ score_z, data = dd)
m_full <- coxph(Surv(OS_time, OS) ~ score_z + age10 + stage, data = dd)

pull <- function(m, lab) {
  z <- summary(m)
  data.table(model = lab, term = rownames(z$coefficients),
             HR = z$coefficients[, "exp(coef)"],
             lo = z$conf.int[, "lower .95"], hi = z$conf.int[, "upper .95"],
             p = z$coefficients[, "Pr(>|z|)"],
             C_index = unname(z$concordance[1]), n = m$n, events = m$nevent)
}
mv <- rbindlist(list(pull(m_uni, "score only"), pull(m_full, "score + age + stage")))
fwrite(mv, file.path(TAB, "04_multivariable_Cox_six_gene_score.csv"))
print(mv)
cat("C-index: score", round(summary(m_uni)$concordance[1], 3),
    "| score + age + stage", round(summary(m_full)$concordance[1], 3), "\n")
cat("LRT score vs full: p =",
    format.pval(anova(m_uni, m_full)$`Pr(>|Chi|)`[2], digits = 3), "\n")


# =====================================================================
# Section 3. Per-gene overall survival by optimal expression cutoff
# =====================================================================
# Six genes, per-gene optimal expression cutoff, overall survival in TCGA-COAD training set.
# Tumour samples only; one primary tumour per patient (n=434, 95 deaths).

root <- KM_DIR
tabdir <- file.path(root, "tables")
figdir <- file.path(root, "figures")
dir.create(tabdir, showWarnings = FALSE, recursive = TRUE)
dir.create(figdir, showWarnings = FALSE, recursive = TRUE)

suppressPackageStartupMessages({
  library(data.table)
  library(survival)
  library(survminer)
  library(maxstat)
  library(ggplot2)
})

## ---- data ---------------------------------------------------------------
expr <- fread(EXPR_FILE)
setnames(expr, 1, "gene")
surv <- fread(SURV_FILE)
genes <- c("FJX1", "TIMP1", "SRMS", "ZBTB12", "KPNA2", "BGN")
samples <- surv$sample
stopifnot(all(samples %in% names(expr)))

emat <- expr[gene %in% genes, c("gene", samples), with = FALSE]
mat <- as.matrix(emat[, ..samples])
rownames(mat) <- emat$gene
stopifnot(all(genes %in% rownames(mat)))

d <- data.table(sample = samples, OS_time = surv$OS_time, OS = surv$OS)
for (g in genes) d[[g]] <- as.numeric(mat[g, samples])
stopifnot(!anyNA(d[, ..genes]), all(d$OS_time > 0), all(d$OS %in% c(0, 1)))

## ---- per-gene optimal cutoff -------------------------------------------
## Maximally selected log-rank statistic; each group at least 20% of samples.
cp <- surv_cutpoint(d, time = "OS_time", event = "OS", variables = genes,
                    minprop = 0.20, progressbar = FALSE)
cut_tab <- as.data.table(cp$cutpoint, keep.rownames = "gene")
setnames(cut_tab, c("gene", "cutoff", "cutpoint_stat"))

## maxstat selection-adjusted p (Lau94), for sensitivity only.
maxstat_p <- vapply(genes, function(g) {
  f <- as.formula(paste0("Surv(OS_time, OS) ~ ", g))
  tryCatch(maxstat.test(f, data = d, smethod = "LogRank",
                        pmethod = "Lau94", minprop = 0.20)$p.value,
           error = function(e) NA_real_)
}, numeric(1))
maxstat_tab <- data.table(gene = genes, maxstat_p = maxstat_p)

## ---- survival statistics -------------------------------------------------
times <- c(365.25, 1095.75, 1826.25)  # 1, 3, 5 years in days
res_list <- list()
km_list <- list()

fmt_p <- function(p) sprintf("P = %.4f", p)

for (g in genes) {
  co <- cut_tab[gene == g, cutoff]
  grp <- factor(ifelse(d[[g]] > co, "High", "Low"), levels = c("Low", "High"))
  dd <- data.table(time = d$OS_time, event = d$OS, group = grp)

  fit <- survfit(Surv(time, event) ~ group, data = dd)
  lr <- survdiff(Surv(time, event) ~ group, data = dd)
  p_lr <- 1 - pchisq(lr$chisq, df = 1)

  cox <- coxph(Surv(time, event) ~ group, data = dd)
  b <- coef(cox)[["groupHigh"]]
  se <- sqrt(vcov(cox)["groupHigh", "groupHigh"])
  hr <- exp(b); hr_lo <- exp(b - 1.96 * se); hr_hi <- exp(b + 1.96 * se)
  p_cox <- summary(cox)$coefficients["groupHigh", "Pr(>|z|)"]

  tb <- summary(fit)$table
  med_low <- unname(tb["group=Low", "median"])
  med_high <- unname(tb["group=High", "median"])

  st <- summary(fit, times = times, extend = TRUE)
  sv <- data.table(group = sub("group=", "", as.character(st$strata)),
                   time = st$time, surv = st$surv)
  get_s <- function(grp, tt) sv[group == grp & abs(time - tt) < 1e-6, surv][1]

  res_list[[g]] <- data.table(
    gene = g,
    cutoff = co,
    n_low = sum(grp == "Low"), n_high = sum(grp == "High"),
    deaths_low = sum(dd$event[grp == "Low"]),
    deaths_high = sum(dd$event[grp == "High"]),
    median_OS_low_days = med_low,
    median_OS_high_days = med_high,
    surv_1y_low = get_s("Low", times[1]), surv_1y_high = get_s("High", times[1]),
    surv_3y_low = get_s("Low", times[2]), surv_3y_high = get_s("High", times[2]),
    surv_5y_low = get_s("Low", times[3]), surv_5y_high = get_s("High", times[3]),
    logrank_p = p_lr,
    HR = hr, HR_low = hr_lo, HR_high = hr_hi, cox_p = p_cox
  )

  sf <- surv_summary(fit, data = dd)
  sf$gene <- g
  km_list[[g]] <- as.data.table(sf)[, .(gene, strata, time, surv, n.censor)]
}

res <- rbindlist(res_list)
res <- merge(res, maxstat_tab, by = "gene", all.x = TRUE)
res[, FDR := p.adjust(logrank_p, method = "BH")]
res[, FDR_maxstat := p.adjust(maxstat_p, method = "BH")]
setorder(res, logrank_p)

## ---- KM data ------------------------------------------------------------
km <- rbindlist(km_list, use.names = TRUE, fill = TRUE)
km[, group := sub("group=", "", as.character(strata))]
km <- km[, .(gene, group, time, surv, n.censor)]
zero <- km[, .(time = 0, surv = 1, n.censor = 0), by = .(gene, group)]
km <- rbind(zero, km, fill = TRUE)
km[, `:=`(gene = factor(gene, levels = genes),
          group = factor(group, levels = c("Low", "High")))]
setorder(km, gene, group, time)
km[, time_years := time / 365.25]
cens <- km[n.censor > 0 & time > 0]

ann <- res[, .(gene,
               stat = paste0("log-rank ", fmt_p(logrank_p),
                             "\nHR ", sprintf("%.2f", HR),
                             " (", sprintf("%.2f", HR_low), "\u2013",
                             sprintf("%.2f", HR_high), ")"),
               cutlab = sprintf("cutoff %.2f\nLow %d / High %d", cutoff, n_low, n_high))]
ann[, gene := factor(gene, levels = genes)]

## ---- figure -------------------------------------------------------------
p <- ggplot(km, aes(x = time_years, y = surv, colour = group)) +
  geom_step(linewidth = 0.72) +
  geom_point(data = cens, aes(x = time_years, y = surv, colour = group),
             shape = 3, size = 1.25, stroke = 0.45, show.legend = FALSE) +
  geom_text(data = ann, aes(x = 12.35, y = 0.055, label = stat),
            inherit.aes = FALSE, hjust = 1, vjust = 0,
            size = 2.85, lineheight = 1.0, family = "Arial") +
  geom_text(data = ann, aes(x = 0.3, y = 0.105, label = cutlab),
            inherit.aes = FALSE, hjust = 0, vjust = 0,
            size = 2.55, lineheight = 0.95, family = "Arial", colour = "grey35") +
  facet_wrap(~ gene, nrow = 2) +
  scale_colour_manual(values = c(Low = "#2E86AB", High = "#C0392B"),
                      labels = c("Low (\u2264 cutoff)", "High (> cutoff)"),
                      name = "Expression") +
  scale_x_continuous(breaks = seq(0, 12, 3)) +
  scale_y_continuous(breaks = seq(0, 1, 0.25)) +
  coord_cartesian(xlim = c(0, 12.5), ylim = c(0, 1)) +
  labs(title = "Six genes: overall survival by optimal expression cutoff",
       subtitle = "TCGA-COAD training set, 434 tumours / 95 deaths; per-gene optimal cutoff (maximally selected log-rank, minprop 0.20); HR = high vs low",
       x = "Time (years)", y = "Overall survival") +
  theme_bw(base_size = 10.5, base_family = "Arial") +
  theme(panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        strip.background = element_rect(fill = "grey92", colour = "grey60", linewidth = 0.3),
        strip.text = element_text(face = "bold", size = 10.2),
        axis.text = element_text(size = 9.4),
        axis.title = element_text(size = 10),
        legend.position = "top",
        legend.title = element_text(size = 10),
        legend.text = element_text(size = 9.2),
        plot.title = element_text(size = 13, face = "bold"),
        plot.subtitle = element_text(size = 8.7),
        plot.margin = margin(8, 10, 6, 8))

quartz(type = "pdf", file = file.path(figdir, "01_six_gene_optimal_cutoff_KM.pdf"),
       width = 12, height = 7.4, family = "Arial")
print(p); dev.off()

png(file.path(figdir, "01_six_gene_optimal_cutoff_KM.png"),
    width = 12, height = 7.4, res = 400, units = "in", family = "Arial")
print(p); dev.off()

## ---- tables -------------------------------------------------------------
# Per-sample expression and group assignment
out_d <- copy(d)
for (g in genes) {
  co <- cut_tab[gene == g, cutoff]
  set(out_d, j = paste0("group_", g), value = ifelse(d[[g]] > co, "High", "Low"))
}
fwrite(out_d, file.path(tabdir, "01_six_gene_expression_and_cutoff_groups.csv"))
fwrite(res, file.path(tabdir, "02_six_gene_optimal_cutoff_survival_stats.csv"))

# Median-split comparison, from the earlier analysis
med_file <- file.path(KM_MEDIAN_DIR, "tables", "02_six_gene_median_group_survival_stats.csv")
if (file.exists(med_file)) {
  med <- fread(med_file)[, .(gene, median_logrank_p = logrank_p, median_FDR = FDR)]
  cmp <- merge(res[, .(gene, cutoff, n_low, n_high, HR, HR_low, HR_high,
                       logrank_p, FDR, maxstat_p, FDR_maxstat)],
               med, by = "gene", all.x = TRUE)
  setorder(cmp, logrank_p)
  fwrite(cmp, file.path(tabdir, "03_median_vs_optimal_cutoff.csv"))
}

cat("Genes:", paste(genes, collapse = ", "), "\n")
cat("Samples:", nrow(d), "deaths:", sum(d$OS), "\n")
print(res[, .(gene, cutoff, n_low, n_high, deaths_low, deaths_high,
              logrank_p, FDR, HR, HR_low, HR_high, maxstat_p)])
