# =====================================================================
# Section 4. Application of the six-gene Cox score in GSE72970
#   the TCGA-trained coefficients are applied unchanged, samples are
#   split at the median score, and survival and discrimination are
#   evaluated in the external cohort
# =====================================================================
suppressPackageStartupMessages({library(data.table); library(survival); library(ggplot2); library(timeROC)})

## 1. Fixed TCGA-trained coefficients (from Section 2).
b <- setNames(coef_tab$coef, coef_tab$gene)
genes <- names(b)

## 2. Apply the score to GSE72970 colon tumours.
e <- readRDS(file.path(GSE_DATA_DIR, "expr.rds"))
c <- readRDS(file.path(GSE_DATA_DIR, "clinical.rds"))
stopifnot(identical(colnames(e), c$sample), all(genes %in% rownames(e)))

score <- as.numeric(t(e[genes, , drop = FALSE]) %*% b)
group <- ifelse(score > median(score), "High", "Low")
risk_tab <- data.frame(sample = c$sample, risk_score = score, risk_group = group,
                       OS_time = c$OS_time, OS_status = c$OS_status,
                       t(e[genes, , drop = FALSE]), check.names = FALSE)
fwrite(risk_tab, file.path(GSE_DIR, "tables", "01_GSE72970_six_gene_risk_scores.csv"))

## 3. Gene expression differences between risk groups.
st <- do.call(rbind, lapply(genes, function(g) {
  lo <- e[g, group == "Low"]; hi <- e[g, group == "High"]
  data.frame(gene = g, n_low = length(lo), n_high = length(hi),
             mean_low = mean(lo), mean_high = mean(hi),
             median_low = median(lo), median_high = median(hi),
             diff_high_minus_low = mean(hi) - mean(lo),
             wilcox_p = wilcox.test(hi, lo)$p.value,
             t_p = t.test(hi, lo)$p.value)
}))
st$FDR <- p.adjust(st$wilcox_p, method = "BH")
fwrite(st, file.path(GSE_DIR, "tables", "02_GSE72970_risk_group_six_gene_expression_stats.csv"))

## 4. Expression boxplots in the two risk groups.
long <- do.call(rbind, lapply(genes, function(g) data.frame(
  gene = g, group = factor(group, levels = c("Low", "High")), value = as.numeric(e[g, ])
)))
long$gene <- factor(long$gene, levels = genes)
ann <- do.call(rbind, lapply(genes, function(g) {
  v <- long$value[long$gene == g]
  data.frame(gene = factor(g, levels = genes), x = 1.5,
             y = max(v) + 0.09 * diff(range(v)),
             lab = sprintf("P = %.2g", st$wilcox_p[match(g, st$gene)]))
}))
p <- ggplot(long, aes(x = group, y = value, fill = group)) +
  geom_boxplot(outlier.shape = NA, linewidth = 0.3, width = 0.58) +
  geom_jitter(width = 0.14, size = 0.35, alpha = 0.35, color = "grey25") +
  geom_text(data = ann, aes(x = x, y = y, label = lab), inherit.aes = FALSE, size = 2.7) +
  facet_wrap(~ gene, nrow = 2, scales = "free_y") +
  scale_fill_manual(values = c(Low = "#4C78A8", High = "#C1663F")) +
  labs(x = NULL, y = "log2 expression", fill = NULL,
       title = "GSE72970: six-gene expression by risk group",
       subtitle = sprintf("Median split of the TCGA-trained six-gene Cox score; %d low / %d high; Wilcoxon P",
                          sum(group == "Low"), sum(group == "High"))) +
  theme_bw(base_size = 9) +
  theme(legend.position = "bottom",
        strip.text = element_text(face = "bold", size = 8),
        plot.title = element_text(face = "bold", size = 10),
        plot.subtitle = element_text(size = 7.8),
        panel.grid.minor = element_blank())
ggsave(file.path(GSE_DIR, "figures", "01_GSE72970_risk_group_six_gene_expression.pdf"),
       p, width = 8.2, height = 6.2)
ggsave(file.path(GSE_DIR, "figures", "01_GSE72970_risk_group_six_gene_expression.png"),
       p, width = 8.2, height = 6.2, dpi = 400)

## 5. Kaplan-Meier and time-dependent AUC of the fixed score.
gdf <- data.table(OS_years = c$OS_time / 365.25, OS = c$OS_status,
                  risk = factor(group, levels = c("Low", "High")))
km <- survfit(Surv(OS_years, OS) ~ risk, data = gdf)
lr <- survdiff(Surv(OS_years, OS) ~ risk, data = gdf)
p_lr <- 1 - pchisq(lr$chisq, df = 1)
cx <- summary(coxph(Surv(OS_years, OS) ~ risk, data = gdf))
cat("GSE72970 log-rank P =", format.pval(p_lr, digits = 3),
    " HR (high vs low) =", round(cx$conf.int[1], 2),
    "(", round(cx$conf.int[3], 2), "-", round(cx$conf.int[4], 2), ")\n")

gd <- timeROC(T = gdf$OS_years, delta = gdf$OS, marker = risk_tab$risk_score,
              cause = 1, times = c(3, 5), iid = FALSE)
cat("GSE72970 time-dependent AUC (3/5 years):",
    paste(round(gd$AUC, 3), collapse = " | "), "\n")

kdf <- data.table(time = km$time, surv = km$surv, nc = km$n.censor,
                  risk = rep(sub("^risk=", "", names(km$strata)), km$strata))
kdf <- rbind(data.table(time = 0, surv = 1, nc = 0, risk = c("Low", "High")), kdf)
kdf[, risk := factor(risk, levels = c("Low", "High"))]

p_km <- ggplot(kdf, aes(time, surv, colour = risk)) +
  geom_step(linewidth = 0.8) +
  geom_point(data = kdf[nc > 0], shape = 3, size = 1.1, stroke = 0.4, show.legend = FALSE) +
  scale_colour_manual(values = c(Low = "#2E86AB", High = "#C0392B"), name = "Six-gene score") +
  coord_cartesian(xlim = c(0, 6.5), ylim = c(0, 1)) +
  scale_x_continuous(breaks = seq(0, 6, 2)) +
  scale_y_continuous(breaks = seq(0, 1, 0.25)) +
  labs(x = "Years", y = "Overall survival",
       title = "GSE72970: overall survival by six-gene score",
       subtitle = sprintf("n = %d, %d deaths; log-rank P = %.3g; HR = %.2f (%.2f-%.2f); 3/5-year AUC %.2f/%.2f",
                          nrow(gdf), sum(gdf$OS), p_lr,
                          cx$conf.int[1], cx$conf.int[3], cx$conf.int[4],
                          gd$AUC[1], gd$AUC[2])) +
  theme_bw(base_size = 10) +
  theme(panel.grid.minor = element_blank(),
        plot.title = element_text(face = "bold", size = 11),
        plot.subtitle = element_text(size = 8.0))
ggsave(file.path(GSE_DIR, "figures", "02_GSE72970_KM_six_gene_score.pdf"),
       p_km, width = 6.2, height = 4.6)
ggsave(file.path(GSE_DIR, "figures", "02_GSE72970_KM_six_gene_score.png"),
       p_km, width = 6.2, height = 4.6, dpi = 400)

fwrite(data.table(endpoint = "OS", n = nrow(gdf), events = sum(gdf$OS),
                  logrank_p = p_lr, hr = cx$conf.int[1], hr_low = cx$conf.int[3],
                  hr_high = cx$conf.int[4], auc_3y = gd$AUC[1], auc_5y = gd$AUC[2]),
       file.path(GSE_DIR, "tables", "03_GSE72970_KM_AUC_summary.csv"))

