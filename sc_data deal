  "Mature Enterocytes type 1": "#BF5D85",
}

save_dir = "/ZXL/TU2"
if not os.path.exists(save_dir):
    os.makedirs(save_dir)

available_cell_types = adata.obs['Cell_subtype'].unique().tolist()

# Keep only cell types defined in End_col and present in the data
desired_order = [cell_type for cell_type in End_col.keys() if cell_type in available_cell_types]

# Create a color dictionary with only the available cell types
available_colors = {cell_type: End_col[cell_type] for cell_type in desired_order}

print(f"Cell types present in the data: {desired_order}")

for pathway_name, genes in pathway.items():
    try:
        # Keep only genes present in adata
        genes_in_data = [gene for gene in genes if gene in adata.var_names]
        if len(genes_in_data) == 0:
            print(f"No genes of pathway {pathway_name} are present in the data; skipping")
            continue
        
        score_name = f"{pathway_name}_score"
        sc.tl.score_genes(adata, genes_in_data, score_name=score_name)
        
        plt.rcParams['pdf.fonttype'] = 42
        plt.rcParams['ps.fonttype'] = 42
        fig, ax = plt.subplots(figsize=(9, 5), dpi=300)
        
        # Use available_colors and desired_order
        sns.violinplot(
            data=adata.obs, x="Cell_subtype", y=score_name,
            order=desired_order, palette=available_colors,
            inner=None, linewidth=0.8, ax=ax
        )
        sns.boxplot(
            data=adata.obs, x="Cell_subtype", y=score_name,
            order=desired_order, width=0.12, fliersize=0, showcaps=True,
            boxprops={'facecolor': 'none', 'edgecolor': 'black', 'linewidth': 1},
            whiskerprops={'color': 'black', 'linewidth': 1},
            medianprops={'color': 'black', 'linewidth': 1.5},
            ax=ax
        )

        ax.set_xlabel('')
        ax.set_ylabel(f'{pathway_name} score', fontsize=11)
        ax.set_xticklabels(desired_order, rotation=90, ha='center', fontsize=9)
        ax.grid(False)
        plt.tight_layout()
        
        pdf_path = os.path.join(save_dir, f"{pathway_name}_violin.pdf")
        plt.savefig(pdf_path, dpi=300, bbox_inches='tight', transparent=True)
        plt.close()
        print(f"Pathway {pathway_name} processed; saved to {pdf_path}")
        
    except Exception as e:
        print(f"Pathway {pathway_name} failed: {e}")
