import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
import matplotlib.patches as mpatches
import os
import scanpy as sc

# Set the color dictionary
celltype_colors = {
    "B cells": "#6B7ABB",
    "Epithelial cells": "#F16E69",
    "Mast cells": "#8AC4CC",
     "Myeloids":  "#A5B45E",
       "Stromal cells": "#C894BF",
    "T cells": "#FBAD36",
    "NK cells":"#BF5D85",}

# Organize the color dictionary (must be defined)
tissue_colors = {
    'Normal': '#4CAF50',
    'Tumor': '#F44336',
   
}

# Set the column names
col_sample = 'Sample'
col_tissue = 'Class'
col_celltype = 'cell_type'

# Set the plotting parameters
plt.rcParams['pdf.fonttype'] = 42
plt.rcParams['ps.fonttype'] = 42

# Create the output directory
if not os.path.exists('plots'):
    os.makedirs('plots')
obs=adata.obs
# ==================== Composition plot ====================
# Assume obs is the AnnData obs data frame
sample_meta = obs[[col_sample, col_tissue,]].drop_duplicates(subset=[col_sample]).set_index(col_sample)


# Compute cell-type proportions
props = pd.crosstab(obs[col_sample], obs[col_celltype], normalize='index') * 100

# Order cell types according to the color dictionary
ordered_cols = [c for c in celltype_colors.keys() if c in props.columns]
props = props[ordered_cols]

# Group by tissue order
tissue_order = ['Normal', 'Tumor']
grouped = sample_meta.groupby(col_tissue, observed=True)
tissues_present = [t for t in tissue_order if t in grouped.groups]
width_ratios = [len(grouped.groups[t]) for t in tissues_present]

# Create the figure
fig = plt.figure(figsize=(20, 6))
gs = GridSpec(nrows=2, ncols=len(tissues_present), width_ratios=width_ratios,
              height_ratios=[0.5, 10], wspace=0.08, hspace=0.05)

axes_main = []

for i, tissue in enumerate(tissues_present):
    df_tissue = sample_meta[sample_meta[col_tissue] == tissue]
    samples_in_tissue = df_tissue.index.tolist()
    n_samples = len(samples_in_tissue)
    
    # Add the title
    ax_title = fig.add_subplot(gs[0, i])
    ax_title.axis('off')
    color = tissue_colors.get(tissue, '#D3D3D3')
    rect = mpatches.Rectangle((0, 0), 1, 1, transform=ax_title.transAxes,
                              color=color, alpha=0.6, zorder=-1)
    ax_title.add_patch(rect)
    
    # Show tissue names
    if n_samples < 20:
        ax_title.text(0.5, 0.5, tissue, ha='center', va='center', fontsize=11,
                      fontweight='bold', transform=ax_title.transAxes,
                      clip_on=False, zorder=100)
    else:
        ax_title.text(0.5, 0.5, tissue, ha='center', va='center', fontsize=13,
                      fontweight='bold', transform=ax_title.transAxes, zorder=100)
    
    ax_title.set_xticks([])
    ax_title.set_yticks([])
    for spine in ax_title.spines.values():
        spine.set_visible(False)
    
    # Add the main panel
    if i == 0:
        ax_main = fig.add_subplot(gs[1, i])
        ax_main.set_ylabel('Percentage (%)', fontsize=12, fontweight='bold')
    else:
        ax_main = fig.add_subplot(gs[1, i], sharey=axes_main[0])
        ax_main.set_yticks([])
        ax_main.spines['left'].set_visible(False)
    
    axes_main.append(ax_main)
    
    # Draw the stacked bar plot
    if n_samples > 0:
        props_tissue = props.loc[samples_in_tissue]
        colors = [celltype_colors[ct] for ct in ordered_cols]
        
        props_tissue.plot(kind='area', stacked=True, color=colors,
                          ax=ax_main, legend=False, linewidth=0, alpha=1.0)
        ax_main.set_xlim(0, n_samples - 1)
    
    ax_main.set_xticks([])
    ax_main.set_xlabel('')
    ax_main.set_ylim(0, 100)
    ax_main.tick_params(axis='both', which='both', length=0)
    
    if i > 0:
        ax_main.set_yticks([])
        ax_main.spines['left'].set_visible(False)
    
    ax_main.spines['top'].set_visible(False)
    ax_main.spines['right'].set_visible(False)

# Add the legend
handles_tissue = [mpatches.Patch(color=tissue_colors[k], label=k) for k in tissue_order]
handles_cell = [mpatches.Patch(color=celltype_colors[k], label=k) for k in ordered_cols]

leg1 = axes_main[-1].legend(handles=handles_tissue, title='Tissue', 
                            bbox_to_anchor=(1.02, 1), loc='upper left', frameon=False)
leg2 = axes_main[-1].legend(handles=handles_cell, title='Cell Types', 
                            bbox_to_anchor=(1.02, 0.6), loc='upper left', frameon=False)
axes_main[-1].add_artist(leg1)

# Save the figure
save_path = '/ZXL/TU/5.Composition.pdf'
plt.savefig(save_path, bbox_inches='tight', transparent=True, format='pdf')
plt.show()
plt.close()

